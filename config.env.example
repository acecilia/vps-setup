# ─────────────────────────────────────────────────────────────────────────────
# config.env — settings for harden-vps.sh
#
# Copy this file to `config.env` and edit. The script reads it automatically.
#   cp config.env.example config.env && nano config.env
#
# Anything left blank falls back to an interactive prompt (or a safe default).
# Never commit your real config.env — it's gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── User account ─────────────────────────────────────────────────────────────
# The non-root sudo user that will own SSH access and run your tooling.
USERNAME="andres"

# Your SSH *public* key (the contents of ~/.ssh/id_ed25519.pub on your laptop).
# Paste the whole single line, e.g. "ssh-ed25519 AAAA... you@laptop".
SSH_PUBLIC_KEY=""

# Give the user passwordless sudo? (true/false)
# Convenient for automation; slightly less safe. Default true.
PASSWORDLESS_SUDO="true"

# ── Tailscale ────────────────────────────────────────────────────────────────
# Pre-authenticated key from https://login.tailscale.com/admin/settings/keys
# Leave blank to run `tailscale up` interactively (you'll click a login URL).
# An ephemeral, pre-approved, tagged key works best for servers.
TAILSCALE_AUTHKEY=""

# Advertise Tailscale SSH (lets you SSH over Tailscale's own ACL-based SSH).
TAILSCALE_SSH="true"

# After Tailscale is confirmed up, restrict OS-level SSH to the tailscale0
# interface only, making port 22 invisible to the public internet. (true/false)
# If false, public SSH stays open (still protected by fail2ban + key-only auth).
SSH_TAILSCALE_ONLY="true"

# ── cloudflared (Cloudflare Tunnel) ──────────────────────────────────────────
# Install cloudflared so you can expose services with zero open inbound ports.
INSTALL_CLOUDFLARED="true"

# Token for a *remotely-managed* tunnel (created in the Cloudflare Zero Trust
# dashboard → Networks → Tunnels → "Install connector"). If set, the script
# installs it as a system service non-interactively. Leave blank to just
# install the binary and finish tunnel setup yourself later.
CLOUDFLARED_TUNNEL_TOKEN=""

# ── SSH daemon hardening ─────────────────────────────────────────────────────
SSH_PORT="22"                 # keep 22 if going Tailscale-only; no need to move it
PERMIT_ROOT_LOGIN="no"        # no | prohibit-password
PASSWORD_AUTH="no"            # force key-based auth

# ── fail2ban ─────────────────────────────────────────────────────────────────
F2B_BANTIME="24h"             # how long an IP stays banned
F2B_FINDTIME="10m"            # window to count failures in
F2B_MAXRETRY="3"              # failures before a ban

# ── Misc ─────────────────────────────────────────────────────────────────────
ENABLE_UNATTENDED_UPGRADES="true"   # auto-install security updates
SET_TIMEZONE=""                     # e.g. "Europe/Madrid"; blank = leave as-is
